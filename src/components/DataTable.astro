---
import Icon from './Icon.astro';
interface Props {columns:string[]; rows:(string|number)[][];title?:string;cockpit?:boolean;slug?:string;detalhes?:unknown[];real?:boolean;busca?:string[];}
const {columns:sourceColumns,rows:sourceRows,title='Registros',cockpit=false,slug='',detalhes,real=false,busca}=Astro.props;
const indices=sourceColumns.map((_,i)=>i).filter(i=>!/^a[çc][aã]o$/i.test(sourceColumns[i]));
const columns=indices.map(i=>sourceColumns[i]==='Code'?'Código':sourceColumns[i]);const rows=sourceRows.map(r=>indices.map(i=>r[i]));
const tabIndex=slug==='documentos'?2:3;
const tabValues=slug==='documentos'?['ETP','DFD','TR','EDITAL']:['Abertas','Em andamento','Encerradas'];
const bucket=(r:(string|number)[])=>slug==='documentos'?String(r[tabIndex]):/concluído|encerrad/i.test(String(r[tabIndex]))?'Encerradas':/andamento/i.test(String(r[tabIndex]))?'Em andamento':'Abertas';
const money=(v:string|number)=>Number(v).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const expiry=(v:string|number)=>{const [d,m,y]=String(v).split('/').map(Number);const days=(Date.UTC(y,m-1,d)-Date.UTC(2026,10,7))/86400000;return days<0?'Vencida':days<=60?'Vencendo':'Vigente'};
const tone=(v:string|number)=>/vencido|alta/i.test(String(v))?'danger':/atenção|análise|pendente/i.test(String(v))?'warning':'success';
---
<div class={slug==='processos'||slug==='cotacoes'?'process-table':undefined} data-real={real?'true':undefined} data-table tabindex="-1" aria-label={title} data-price={slug==='banco-de-precos'?columns.indexOf('Preço unitário'):undefined}>
{['processos','cotacoes','documentos'].includes(slug)&&<div class="actions tabs" aria-label="Abas de registros"><button data-tab="" aria-pressed="true">Todos <span class="pill">{rows.length}</span></button>{tabValues.map(t=><button data-tab={t} aria-pressed="false">{t} <span class="pill">{rows.filter(r=>bucket(r)===t).length}</span></button>)}</div>}<div class="filters"><label>Buscar {title.toLowerCase()}<input data-table-search type="search" placeholder="Buscar registros"/></label><label>Filtrar por valor<select data-table-filter><option value="">Todos</option>{[...new Set(rows.map((r:(string|number)[])=>String(r[Math.min(2,columns.length-1)])))].map(v=><option value={v}>{v}</option>)}</select></label></div>{cockpit&&<div class="filters"><label>Data inicial<input type="date" data-start/></label><label>Data final<input type="date" data-end/></label><label>Status<select data-status><option value="">Todos</option>{[...new Set(rows.map(r=>String(r[4])))].map(v=><option>{v}</option>)}</select></label><label>Prioridade<select data-priority><option value="">Todas</option><option>Alta</option><option>Normal</option></select></label><label>Equipe<select data-team><option value="">Todas</option><option>Educação</option><option>Saúde</option><option>Infraestrutura</option><option>Administração</option></select></label></div>}<p data-table-count role="status"></p><div class="table-wrap"><table><caption class="sr-only">{title} — {real?'dados reais de fontes oficiais':'dados de exemplo'}</caption><thead><tr>{columns.map((c:string,i:number)=><th scope="col" aria-sort="none"><button data-sort={i}>{c} ↕</button></th>)}<th scope="col">Detalhes</th></tr></thead><tbody>{rows.map((r:(string|number)[],ri:number)=><tr data-row data-bucket={bucket(r)} data-values={JSON.stringify(r)} data-detalhe={detalhes?JSON.stringify(detalhes[ri]):undefined} data-busca={busca?busca[ri]:undefined}>{r.map((v,i)=><td>{columns[i]==='Vigência'?<span class={`status ${expiry(v)==='Vencida'?'danger':expiry(v)==='Vencendo'?'warning':'success'}`}>{String(v)} · {expiry(v)}</span>:/status|situação|sla|saúde/i.test(columns[i])?<span class={`status ${tone(v)}`}>{String(v)}</span>:/preço|valor/i.test(columns[i])?money(v):String(v)}</td>)}<td><button class="secondary" data-detail><Icon name="eye" size={16}/>Ver detalhes</button></td></tr>)}</tbody></table></div><p data-table-empty hidden>Nenhum registro encontrado. Limpe a busca ou altere o filtro.</p><div class="pagination"><label>Itens por página<select data-table-size><option>10</option><option>25</option><option>50</option></select></label><span data-table-range aria-live="polite"></span><div class="pagination-controls"><button class="secondary" data-table-prev><Icon name="chevron-left" size={16}/>Anterior</button><span data-page-numbers class="page-numbers"></span><span data-table-page class="sr-only"></span><button class="secondary" data-table-next><Icon name="chevron-right" size={16}/>Próxima</button></div></div></div>
<script src="../scripts/table.ts"></script>