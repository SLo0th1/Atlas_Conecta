---
interface Props {columns:string[]; rows:(string|number)[][];title?:string;cockpit?:boolean;slug?:string;}
const {columns:sourceColumns,rows:sourceRows,title='Registros',cockpit=false,slug=''}=Astro.props;
const indices=sourceColumns.map((_,i)=>i).filter(i=>!/^a[çc][aã]o$/i.test(sourceColumns[i]));
const columns=indices.map(i=>sourceColumns[i]);const rows=sourceRows.map(r=>indices.map(i=>r[i]));
const tabIndex=slug==='documentos'?2:4;
const tabValues=slug==='documentos'?['ETP','DFD','TR','EDITAL']:['Abertas','Em andamento','Encerradas'];
const bucket=(r:(string|number)[])=>slug==='documentos'?String(r[tabIndex]):/concluído|encerrad/i.test(String(r[tabIndex]))?'Encerradas':/andamento/i.test(String(r[tabIndex]))?'Em andamento':'Abertas';
const money=(v:string|number)=>Number(v).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const expiry=(v:string|number)=>{const [d,m,y]=String(v).split('/').map(Number);const days=(Date.UTC(y,m-1,d)-Date.UTC(2026,10,7))/86400000;return days<0?'Vencida':days<=60?'Vencendo':'Vigente'};
const tone=(v:string|number)=>/vencido|alta/i.test(String(v))?'danger':/atenção|análise|pendente/i.test(String(v))?'warning':'success';
---
<div data-table data-price={slug==='banco-de-precos'?columns.indexOf('Preço unitário'):undefined}>
{['processos','cotacoes','documentos'].includes(slug)&&<div class="actions" aria-label="Abas de registros"><button data-tab="" aria-pressed="true">Todos ({rows.length})</button>{tabValues.map(t=><button data-tab={t} aria-pressed="false">{t} ({rows.filter(r=>bucket(r)===t).length})</button>)}</div>}<div class="filters"><label>Buscar {title.toLowerCase()}<input data-table-search type="search" placeholder="Buscar registros"/></label><label>Filtrar por valor<select data-table-filter><option value="">Todos</option>{[...new Set(rows.map((r:(string|number)[])=>String(r[Math.min(2,columns.length-1)])))].map(v=><option value={v}>{v}</option>)}</select></label><label>Por página<select data-table-size><option>5</option><option>10</option><option>20</option></select></label></div>{cockpit&&<div class="filters"><label>Data inicial<input type="date" data-start/></label><label>Data final<input type="date" data-end/></label><label>Status<select data-status><option value="">Todos</option>{[...new Set(rows.map(r=>String(r[4])))].map(v=><option>{v}</option>)}</select></label><label>Prioridade<select data-priority><option value="">Todas</option><option>Alta</option><option>Normal</option></select></label><label>Equipe<select data-team><option value="">Todas</option><option>Educação</option><option>Saúde</option><option>Infraestrutura</option><option>Administração</option></select></label></div>}<p data-table-count role="status"></p><div class="table-wrap"><table><caption class="sr-only">{title} — dados de exemplo</caption><thead><tr>{columns.map((c:string,i:number)=><th scope="col" aria-sort="none"><button data-sort={i}>{c} ↕</button></th>)}<th scope="col">Detalhes</th></tr></thead><tbody>{rows.map((r:(string|number)[])=><tr data-row data-bucket={bucket(r)} data-values={JSON.stringify(r)}>{r.map((v,i)=><td>{columns[i]==='Vigência'?<span class={`status ${expiry(v)==='Vencida'?'danger':expiry(v)==='Vencendo'?'warning':'success'}`}>{String(v)} · {expiry(v)}</span>:/status|situação|sla|saúde/i.test(columns[i])?<span class={`status ${tone(v)}`}>{String(v)}</span>:/preço|valor/i.test(columns[i])?money(v):String(v)}</td>)}<td><button data-detail>Ver detalhes</button></td></tr>)}</tbody></table></div><p data-table-empty hidden>Nenhum registro encontrado. Limpe a busca ou altere o filtro.</p><div class="pagination"><button data-table-prev>Anterior</button><span data-table-page></span><button data-table-next>Próxima</button></div></div>
<script src="../scripts/table.ts"></script>