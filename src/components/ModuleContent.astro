---
import Icon from './Icon.astro';
import Chart from './Chart.astro';
const {module:m}=Astro.props;
const metrics:Record<string,string[]>={solicitacoes:['Solicitações recebidas','Aguardando triagem'],recursos:['Recursos em análise','Decisões publicadas'],diligencias:['Notificações abertas','Respostas recebidas'],pareceres:['Pareceres pendentes','Respostas técnicas'], 'piloto-automatico':['Regras ativas','Alertas de prazo']};
const stages=[['Planejamento',5],['Pesquisa',8],['Revisão',4],['Publicação',3]] as const;
---
{metrics[m.slug]&&<div class="grid">{metrics[m.slug].map((label,i)=><article class="card kpi"><div class="kpi-top"><span class="kpi-icon"><Icon name="check"/></span><Icon name="trend"/></div><h2 class="metric-title">{label}</h2><strong class="number" data-count={String(i===0?8:4)}>{i===0?8:4}</strong><svg class="kpi-arcs" viewBox="0 0 180 180" fill="none" stroke="currentColor" stroke-width="16" aria-hidden="true"><circle cx="90" cy="90" r="75"/><circle cx="90" cy="90" r="45"/></svg><p>Dados de exemplo</p></article>)}</div>}
{m.slug==='gestao-publica'&&<><article class="card"><h3>Ciclo previsto de compras</h3><p>SLA por etapa · 20 dias úteis previstos</p><div class="sla-bar">{stages.map(([label,days])=><div style={`flex:${days}`}><strong>{label}</strong><br/>{days} dias úteis</div>)}</div></article><div class="management-charts"><Chart title="Distribuição por etapa" stages/><article class="card"><h3>Saúde da carteira</h3><p>24 em dia · 7 em atenção · 3 vencidos</p></article></div><div class="management-queue"><article class="card"><h3>Conversão do portfólio</h3>{[['Demandas',40],['Planejadas',34],['Publicadas',24],['Contratadas',18]].map(([label,n])=><p><span>{label}: {n}</span><meter min="0" max="40" value={n}>{n}</meter></p>)}</article><article class="card"><h3>Fila de atenção do gestor</h3><p>7 processos em atenção · 3 com prazo vencido</p><p>Priorize a revisão das etapas e os prazos de resposta da carteira municipal.</p><a href="#manager-queue">Consultar processos da fila →</a></article></div></>}
{m.slug==='banco-de-precos'&&<><div class="tabs" data-price-tabs><button data-tab="Pesquisa" aria-pressed="true">Pesquisa <span class="pill">1</span></button><button data-tab="Pesquisas" aria-pressed="false">Pesquisas <span class="pill" data-saved-count>0</span></button></div><p id="price-history" role="status" hidden></p><h2>Pesquisa por item</h2><p>Busque na tabela para calcular os preços dos resultados filtrados, incluindo todas as páginas.</p><div class="grid" id="price-stats" aria-live="polite"></div><button id="save-search">Salvar pesquisa</button><p id="saved-search" role="status"></p></>}
{['produtos','fornecedores','enderecos','locais-de-entrega'].includes(m.slug)&&<button class="secondary" data-import><Icon name="upload" size={16}/>Importar planilha</button>}
{m.slug==='relatorios'&&<div class="grid">{['Execução das compras','Prazos por secretaria','Pesquisa de preços','Participação de fornecedores'].map(t=><article class="card"><h2 class="metric-title">{t}</h2><p>Resumo demonstrativo do período de novembro de 2026.</p><button data-report={t}>Ver prévia</button></article>)}</div>}
<dialog id="import-dialog"><h2>Importar planilha</h2><p>Protótipo: o arquivo não é enviado nem gravado. Modelo: código, nome e descrição.</p><label>Planilha de exemplo<input type="file" accept=".csv,.xlsx"/></label><p>Prévia ilustrativa: GYN-001 · Cadastro municipal · Ativo</p><form method="dialog"><button><Icon name="x" size={16}/>Fechar</button></form></dialog>
<dialog id="report-dialog"><h2 id="report-title">Prévia do relatório</h2><p>Novembro de 2026 · dados de exemplo</p><p>34 processos acompanhados · 24 dentro do prazo · 18 contratações concluídas.</p><p>Protótipo: nada é gravado.</p><form method="dialog"><button><Icon name="x" size={16}/>Fechar</button></form></dialog>
<script>
document.addEventListener('astro:page-load',()=>{

const priceTabs=document.querySelector<HTMLElement>('[data-price-tabs]');const priceIndicator=document.createElement('span');priceIndicator.className='tab-indicator';priceIndicator.setAttribute('aria-hidden','true');priceTabs?.append(priceIndicator);function movePriceIndicator(){const active=priceTabs?.querySelector<HTMLElement>('[aria-pressed=true]');if(active){priceIndicator.style.width=`${active.offsetWidth}px`;priceIndicator.style.height=`${active.offsetHeight}px`;priceIndicator.style.transform=`translate(${active.offsetLeft}px,${active.offsetTop}px)`}}movePriceIndicator();const priceResize=new ResizeObserver(movePriceIndicator);if(priceTabs)priceResize.observe(priceTabs);document.addEventListener('astro:before-swap',()=>priceResize.disconnect(),{once:true});
document.querySelectorAll<HTMLButtonElement>('[data-price-tabs] button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-price-tabs] button').forEach(t=>t.setAttribute('aria-pressed',String(t===b)));movePriceIndicator();const history=document.querySelector<HTMLElement>('#price-history')!;history.hidden=b.dataset.tab!=='Pesquisas';try{const saved=JSON.parse(localStorage.getItem('atlas-price-search')||'null');history.textContent=saved?`Pesquisa salva neste navegador: ${saved.query||'Todos os itens'}`:'Nenhuma pesquisa salva neste navegador.'}catch{history.textContent='Nenhuma pesquisa disponível.'}}));
try{const count=document.querySelector('[data-saved-count]');if(count)count.textContent=localStorage.getItem('atlas-price-search')?'1':'0'}catch{}
document.querySelector('[data-import]')?.addEventListener('click',()=>document.querySelector<HTMLDialogElement>('#import-dialog')!.showModal());
document.querySelectorAll<HTMLElement>('[data-report]').forEach(b=>b.addEventListener('click',()=>{document.querySelector('#report-title')!.textContent=`Prévia: ${b.dataset.report}`;document.querySelector<HTMLDialogElement>('#report-dialog')!.showModal()}));
document.querySelector('#save-search')?.addEventListener('click',()=>{const query=document.querySelector<HTMLInputElement>('[data-table-search]')!.value;try{localStorage.setItem('atlas-price-search',JSON.stringify({query,savedAt:new Date().toISOString()}));const count=document.querySelector('[data-saved-count]');if(count)count.textContent='1';document.querySelector('#saved-search')!.textContent='Pesquisa salva apenas neste navegador. Protótipo: nenhum envio ao servidor.'}catch{document.querySelector('#saved-search')!.textContent='Armazenamento local indisponível.'}});

});
</script>
