---
import '../../styles/carteira.css';
import type { Ligacao, Situacao, Tela } from '../../lib/govnexa/fluxo.ts';
import { SUBFLUXOS, subfluxoDoNo } from '../../lib/govnexa/subfluxos.ts';
import { municipioAtivo } from '../../lib/municipio-ativo.ts';
import { MARCA } from '../../lib/marca.ts';

// Desenho reutilizável: o mapa geral e cada fluxo detalhado (subprocesso) usam este componente.
type TipoNoGen = 'inicio' | 'tarefa' | 'decisao' | 'excecao' | 'fim';
interface NoGen {
  id: string;
  raia: string;
  linha: number;
  tipo: TipoNoGen;
  titulo: string;
  oQue: string;
  valida: string[];
  quem: string;
  situacao: Situacao;
  fase: string;
  telas: Tela[];
  excecao?: { aceitaQuando: string; registro: string };
}
interface Props {
  raias: { id: string; nome: string; descricao: string }[];
  nos: NoGen[];
  ligacoes: Ligacao[];
  rotuloSituacao: Record<Situacao, string>;
  idPrefixo: string;
  /** Título do diagrama (cabeçalho do PDF e rótulo de acessibilidade). */
  titulo: string;
  /** Mapa geral: mostra o selo "+ detalhe", os links para os fluxos detalhados e a seção "Fluxos detalhados". */
  geral?: boolean;
}
const { raias: RAIAS, nos: NOS, ligacoes: LIGACOES, rotuloSituacao: ROTULO_SITUACAO, idPrefixo, titulo: tituloDiagrama, geral = false } = Astro.props;

// ——— Geometria (viewBox em unidades fixas; o SVG ocupa 100% da largura do contêiner)
const LARGURA = 1000;
const COL = LARGURA / RAIAS.length;
const E = RAIAS.length <= 3 ? 1.25 : 1; // poucas raias: formas e letras maiores
const TOPO = 48;
const MEIA_RAIA = COL / 2 - 16; // meia-largura máxima de uma forma
const MAX_LINHA = Math.max(...NOS.map((n) => n.linha));
type Pt = [number, number];
interface Geo { no: NoGen; col: number; cx: number; cy: number; hw: number; hh: number; k: number; linhas: string[]; fs: number; passo: number; yTit: number; yExc: number; ySit: number; ySelo: number; temSub: boolean }

const rotuloSit = { disponivel: 'disponível', simulacao: 'simulação', planejado: 'planejado' } as const;
const subDe = (id: string) => (geral ? subfluxoDoNo(id) : undefined);

// Quebra por palavras (no servidor)
function quebrar(texto: string, max: number): string[] {
  const linhas: string[] = [];
  let atual = '';
  for (const p of texto.split(/\s+/)) {
    if (atual && (atual + ' ' + p).length > max) { linhas.push(atual); atual = p; }
    else atual = atual ? atual + ' ' + p : p;
  }
  if (atual) linhas.push(atual);
  return linhas;
}
const maxPorTipo = { tarefa: 17, decisao: 14, inicio: 12, fim: 12, excecao: 17 } as const;
const tamFonte = { tarefa: 11.5, decisao: 10.5, inicio: 10.5, fim: 10.5, excecao: 10.5 } as const;
const BASE: Record<TipoNoGen, [number, number]> = { decisao: [82, 46], tarefa: [62, 33], inicio: [44, 44], fim: [44, 44], excecao: [76, 44] };

// Meia-largura disponível da forma a uma distância vertical dy do centro (para conferir se o texto cabe)
function disponivel(tipo: TipoNoGen, hw: number, hh: number, k: number, dy: number): number {
  const d = Math.abs(dy);
  if (d > hh) return 0;
  if (tipo === 'decisao') return hw * (1 - d / hh);
  if (tipo === 'tarefa') return hw;
  if (tipo === 'excecao') return hw - (k * d) / hh;
  return Math.sqrt(Math.max(0, hw * hw - d * d));
}

// 1ª fase: tamanho de cada forma (cresce só se o texto não couber)
const tam = new Map<string, Geo>();
for (const no of NOS) {
  const col = RAIAS.findIndex((r) => r.id === no.raia);
  const fs = tamFonte[no.tipo] * E;
  const passo = fs + 2 * E;
  const linhas = quebrar(no.titulo, maxPorTipo[no.tipo]);
  const temSub = !!subDe(no.id);
  const exc = no.tipo === 'excecao';
  const hTit = linhas.length * passo;
  const hExc = exc ? 11 * E : 0;
  const hSit = 12 * E;
  const hSelo = temSub ? 11 * E : 0;
  const alt = hTit + hExc + hSit + hSelo;
  // posições relativas ao centro (linha de base de cada texto)
  const yTit = -alt / 2 + fs;
  const yExc = yTit + (linhas.length - 1) * passo + 11 * E;
  const ySit = yTit + (linhas.length - 1) * passo + hExc + 12 * E;
  const ySelo = ySit + 11 * E;
  const largura = (t: string, f: number, f0: number) => t.length * f * f0;
  const itens: { dy1: number; dy2: number; w: number }[] = [
    ...linhas.map((t, i) => ({ dy1: yTit + i * passo - fs * 0.8, dy2: yTit + i * passo + fs * 0.25, w: largura(t, fs, 0.6) })),
    { dy1: ySit - 9.5 * E * 0.8, dy2: ySit + 3, w: largura(rotuloSit[no.situacao], 9.5 * E, 0.55) },
  ];
  if (exc) itens.push({ dy1: yExc - 9 * E * 0.8, dy2: yExc + 3, w: largura('exceção', 9 * E, 0.62) });
  if (temSub) itens.push({ dy1: ySelo - 8.5 * E * 0.8, dy2: ySelo + 3, w: largura('+ detalhe', 8.5 * E, 0.62) });
  const [bw, bh] = BASE[no.tipo];
  // A forma nunca passa da largura da própria raia (folga para setas e rótulos); se o texto não couber, cresce na altura.
  const largo = (f: number) => Math.min(bw * E * f, MEIA_RAIA);
  let s = 1;
  for (; s < 4; s += 0.04) {
    const hw = largo(s), hh = bh * E * s, k = Math.min(24 * E * s, hw / 2);
    if (itens.every((it) => disponivel(no.tipo, hw, hh, k, Math.abs(it.dy1) > Math.abs(it.dy2) ? it.dy1 : it.dy2) >= it.w / 2 + 4 && Math.max(Math.abs(it.dy1), Math.abs(it.dy2)) <= hh - 2)) break;
  }
  tam.set(no.id, { no, col, cx: (col + 0.5) * COL, cy: 0, hw: largo(s), hh: bh * E * s, k: Math.min(24 * E * s, largo(s) / 2), linhas, fs, passo, yTit, yExc, ySit, ySelo, temSub });
}
const LIN = Math.max(100 * E, 2 * Math.max(...[...tam.values()].map((g) => g.hh)) + 14);
const ALTURA = TOPO + MAX_LINHA * LIN + 16;
const geo = new Map<string, Geo>();
for (const [id, g] of tam) geo.set(id, { ...g, cy: TOPO + (g.no.linha - 0.5) * LIN });

// Borda da forma em uma posição (para as setas encostarem no contorno)
function bordaY(g: Geo, x: number, lado: 'topo' | 'base'): number {
  const dx = Math.min(Math.abs(x - g.cx), g.hw);
  const t = g.no.tipo;
  const desl = t === 'decisao' ? g.hh * (1 - dx / g.hw) : t === 'tarefa' ? g.hh : t === 'excecao' ? (dx <= g.hw - g.k ? g.hh : (g.hh * (g.hw - dx)) / g.k) : Math.sqrt(Math.max(0, g.hw * g.hw - dx * dx));
  return lado === 'topo' ? g.cy - desl : g.cy + desl;
}
function bordaX(g: Geo, y: number, lado: 'esq' | 'dir'): number {
  const dy = Math.min(Math.abs(y - g.cy), g.hh);
  const t = g.no.tipo;
  const desl = t === 'decisao' ? g.hw * (1 - dy / g.hh) : t === 'tarefa' ? g.hw : t === 'excecao' ? g.hw - (g.k * dy) / g.hh : Math.sqrt(Math.max(0, g.hh * g.hh - dy * dy));
  return lado === 'esq' ? g.cx - desl : g.cx + desl;
}

// Teste de obstrução: o segmento não pode cruzar outra forma
function bate(p: Pt, q: Pt, ignorar: string[]): boolean {
  const x1 = Math.min(p[0], q[0]), x2 = Math.max(p[0], q[0]);
  const y1 = Math.min(p[1], q[1]), y2 = Math.max(p[1], q[1]);
  for (const g of geo.values()) {
    if (ignorar.includes(g.no.id)) continue;
    if (x2 > g.cx - g.hw - 4 && x1 < g.cx + g.hw + 4 && y2 > g.cy - g.hh - 4 && y1 < g.cy + g.hh + 4) return true;
  }
  return false;
}
const livre = (pts: Pt[], ign: string[]) => pts.every((p, i) => i === 0 || !bate(pts[i - 1], p, ign));

const canais = new Map<number, number>();
function canal(y: number): number {
  const n = canais.get(y) ?? 0;
  canais.set(y, n + 1);
  return y - 6 * n;
}
const topoLinha = (linha: number) => TOPO + (linha - 1) * LIN;

// Portas laterais: quando duas ligações usam o mesmo lado de uma forma, a segunda desloca um pouco a linha
const portas = new Map<string, number>();
const DESL = [0, 14, -14, 28];
const chave = (id: string, lado: string) => `${id}:${lado}`;
const desl = (id: string, lado: string) => DESL[Math.min(portas.get(chave(id, lado)) ?? 0, DESL.length - 1)];
const marcar = (id: string, lado: string) => portas.set(chave(id, lado), (portas.get(chave(id, lado)) ?? 0) + 1);

function rotear(de: string, para: string, indice: number): Pt[] {
  const A = geo.get(de)!, B = geo.get(para)!;
  const ign = [de, para];
  if (A.col === B.col) {
    if (B.no.linha > A.no.linha) return [[A.cx, bordaY(A, A.cx, 'base')], [B.cx, bordaY(B, B.cx, 'topo')]];
    const ya = A.cy + desl(de, 'dir'), yb = B.cy + desl(para, 'dir');
    const xo = Math.max(bordaX(A, ya, 'dir'), bordaX(B, yb, 'dir')) + 12;
    marcar(de, 'dir'); marcar(para, 'dir');
    return [[bordaX(A, ya, 'dir'), ya], [xo, ya], [xo, yb], [bordaX(B, yb, 'dir'), yb]];
  }
  const dir = B.col > A.col ? 1 : -1;
  const ladoA = dir > 0 ? 'dir' : 'esq';
  const ladoB = dir > 0 ? 'esq' : 'dir';
  const off = 24 * dir;
  const viaTopo = (linhaTopo: number, sa: 'topo' | 'base', sb: 'topo' | 'base'): Pt[] => {
    const yc = canal(topoLinha(linhaTopo));
    return [[A.cx + off, bordaY(A, A.cx + off, sa)], [A.cx + off, yc], [B.cx - off, yc], [B.cx - off, bordaY(B, B.cx - off, sb)]];
  };
  if (A.no.linha === B.no.linha) {
    const volta = LIGACOES.findIndex((l) => l.de === para && l.para === de);
    if (volta >= 0 && volta < indice) return viaTopo(A.no.linha, 'topo', 'topo'); // ida e volta na mesma linha: a volta passa por cima
    const y = A.cy + Math.max(desl(de, ladoA), desl(para, ladoB));
    const reta: Pt[] = [[bordaX(A, y, ladoA), y], [bordaX(B, y, ladoB), y]];
    if (livre(reta, ign)) { marcar(de, ladoA); marcar(para, ladoB); return reta; }
    return viaTopo(A.no.linha, 'topo', 'topo');
  }
  const abaixo = B.no.linha > A.no.linha;
  const ya = A.cy + desl(de, ladoA), yb = B.cy + desl(para, ladoB);
  if (LIGACOES[indice]?.via === 'lado') {
    const xa = bordaX(A, ya, ladoA), xb = bordaX(B, yb, ladoB), xm = (xa + xb) / 2;
    const z: Pt[] = [[xa, ya], [xm, ya], [xm, yb], [xb, yb]];
    if (livre(z, ign)) { marcar(de, ladoA); marcar(para, ladoB); return z; }
  }
  const candA: Pt[] = [[bordaX(A, ya, ladoA), ya], [B.cx, ya], [B.cx, bordaY(B, B.cx, abaixo ? 'topo' : 'base')]];
  if (livre(candA, ign)) { marcar(de, ladoA); return candA; }
  const candB: Pt[] = [[A.cx, bordaY(A, A.cx, abaixo ? 'base' : 'topo')], [A.cx, yb], [bordaX(B, yb, ladoB), yb]];
  if (livre(candB, ign)) { marcar(para, ladoB); return candB; }
  return abaixo ? viaTopo(B.no.linha, 'base', 'topo') : viaTopo(A.no.linha, 'topo', 'base');
}

// Posição do rótulo da ligação: no primeiro trecho com folga
function posRotulo(pts: Pt[], texto: string, hhMax: number): { x: number; y: number; ancora: 'start' | 'middle' } {
  const trechos = pts.slice(1).map((q, i) => ({ p: pts[i], q, len: Math.abs(q[0] - pts[i][0]) + Math.abs(q[1] - pts[i][1]) }));
  const t = trechos.find((s) => s.len >= 34) ?? trechos.reduce((a, b) => (b.len > a.len ? b : a));
  if (t.p[1] === t.q[1]) {
    // Trecho horizontal mais curto que o texto (ex.: entre duas raias vizinhas): o rótulo sobe acima das formas para não ser coberto.
    const curto = Math.abs(t.q[0] - t.p[0]) < texto.length * 9.5 * 0.55 + 8;
    return { x: (t.p[0] + t.q[0]) / 2, y: curto ? t.p[1] - hhMax - 6 : t.p[1] + (pts.length === 4 ? 11 : -4), ancora: 'middle' };
  }
  const baixo = t.q[1] > t.p[1];
  const yAlvo = trechos.length === 3 && t === trechos[1] ? (t.p[1] + t.q[1]) / 2 + 3 : baixo ? t.p[1] + 14 : (t.p[1] + t.q[1]) / 2 + 3; // subindo: no meio do trecho, longe da forma de onde sai
  return { x: t.p[0] + 8, y: yAlvo, ancora: 'start' };
}

const ligacoes = LIGACOES.map((l, i) => {
  const pts = rotear(l.de, l.para, i);
  const hhMax = Math.max(geo.get(l.de)?.hh ?? 0, geo.get(l.para)?.hh ?? 0);
  const lab = l.rotulo ? posRotulo(pts, l.rotulo, hhMax) : null;
  return { ...l, tipo: l.tipo ?? 'fluxo', pts, d: pts.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' '), lab };
});

// Dados para o detalhe (cliente)
const tituloDe = (id: string) => NOS.find((n) => n.id === id)!.titulo;
const dados = NOS.map((n) => ({
  id: n.id,
  tipo: n.tipo,
  titulo: n.titulo,
  situacao: ROTULO_SITUACAO[n.situacao],
  fase: n.fase,
  raia: RAIAS.find((r) => r.id === n.raia)!.nome,
  oQue: n.oQue,
  valida: n.valida,
  quem: n.quem,
  anteriores: LIGACOES.filter((l) => l.para === n.id).map((l) => ({ id: l.de, titulo: tituloDe(l.de), rotulo: l.rotulo ?? '' })),
  proximas: LIGACOES.filter((l) => l.de === n.id).map((l) => ({ id: l.para, titulo: tituloDe(l.para), rotulo: l.rotulo ?? '' })),
  telas: n.telas,
  excecao: n.excecao ?? null,
  subfluxo: subDe(n.id)?.id ?? null,
}));
const dadosJson = JSON.stringify(dados).replace(/<\//g, '<\\/');
const idDetalhe = `${idPrefixo}-detalhe`;
const proximasTxt = (id: string) => LIGACOES.filter((l) => l.de === id).map((l) => (NOS.find((x) => x.id === l.para)?.titulo ?? l.para) + (l.rotulo ? ' (' + l.rotulo + ')' : '')).join('; ') || '—';
const hex = (g: Geo, m: number) => {
  const w = g.hw + m, h = g.hh + m, k = g.k;
  return `M${g.cx - w} ${g.cy} L${g.cx - w + k} ${g.cy - h} L${g.cx + w - k} ${g.cy - h} L${g.cx + w} ${g.cy} L${g.cx + w - k} ${g.cy + h} L${g.cx - w + k} ${g.cy + h} Z`;
};
---
<div class="fx" data-fluxo data-fx-titulo-pdf={tituloDiagrama}>
  <div class="fx-exportar cart-nao-imprimir">
    <button type="button" class="primary" data-fx-pdf>Exportar em PDF</button>
    <span class="muted">Abre a impressão do navegador: em Destino, escolha <strong>Salvar como PDF</strong>. O PDF traz o diagrama e o detalhe de cada etapa.</span>
  </div>
  <p class="fx-so-impressao fx-cab-impressao"><strong>{MARCA.nome} — {tituloDiagrama}</strong> · {municipioAtivo().nomeExibicao} · <span data-fx-data-impressao></span></p>
  <details class="fx-legenda" data-fx-recolhivel>
    <summary><h2 id={`${idPrefixo}-leg-t`}>Como ler o diagrama</h2></summary>
    <div class="fx-leg-grupos">
      <div>
        <h3>Formas</h3>
        <ul>
          <li><svg viewBox="0 0 28 28" width="26" height="26" aria-hidden="true"><circle cx="14" cy="14" r="11" class="fx-l-forma fx-l-fino"/></svg> Início (borda fina)</li>
          <li><svg viewBox="0 0 36 28" width="34" height="26" aria-hidden="true"><rect x="3" y="5" width="30" height="18" rx="5" class="fx-l-forma"/></svg> Etapa</li>
          <li><svg viewBox="0 0 36 28" width="34" height="26" aria-hidden="true"><path d="M18 2 L33 14 L18 26 L3 14 Z" class="fx-l-forma"/></svg> Decisão (sim ou não)</li>
          <li><svg viewBox="0 0 36 28" width="34" height="26" aria-hidden="true"><path d="M2 14 L9 4 L27 4 L34 14 L27 24 L9 24 Z" class="fx-l-forma fx-l-exc"/></svg> Exceção (aceita e registrada)</li>
          <li><svg viewBox="0 0 28 28" width="26" height="26" aria-hidden="true"><circle cx="14" cy="14" r="10" class="fx-l-forma fx-l-grosso"/></svg> Fim (borda grossa)</li>
        </ul>
      </div>
      <div>
        <h3>Situação no sistema</h3>
        <ul>
          <li><svg viewBox="0 0 36 28" width="34" height="26" aria-hidden="true"><rect x="3" y="5" width="30" height="18" rx="5" class="fx-l-forma fx-s-disponivel"/></svg> Borda contínua verde: disponível</li>
          <li><svg viewBox="0 0 36 28" width="34" height="26" aria-hidden="true"><rect x="3" y="5" width="30" height="18" rx="5" class="fx-l-forma fx-s-simulacao"/></svg> Borda tracejada amarela: simulação</li>
          <li><svg viewBox="0 0 36 28" width="34" height="26" aria-hidden="true"><rect x="3" y="5" width="30" height="18" rx="5" class="fx-l-forma fx-s-planejado"/></svg> Borda pontilhada cinza: planejado</li>
        </ul>
      </div>
      <div>
        <h3>Linhas</h3>
        <ul>
          <li><svg viewBox="0 0 40 14" width="38" height="14" aria-hidden="true"><line x1="2" y1="7" x2="32" y2="7" class="fx-lin fx-lin-fluxo"/><path d="M38 7 L31 3 L31 11 Z" class="fx-seta-fluxo"/></svg> Contínua: caminho do fluxo</li>
          <li><svg viewBox="0 0 40 14" width="38" height="14" aria-hidden="true"><line x1="2" y1="7" x2="32" y2="7" class="fx-lin fx-lin-apoio"/><path d="M38 7 L31 3 L31 11 Z" class="fx-seta-apoio"/></svg> Tracejada: apoio ou informação</li>
        </ul>
      </div>
    </div>
    <p class="muted">As colunas são as áreas (raias) e o tempo corre de cima para baixo. Clique em uma caixa, ou use Tab e Enter, para ver o que é feito, processado e validado e abrir a tela correspondente.{geral ? ' Caixas com "+ detalhe" têm um fluxo detalhado próprio.' : ''}</p>
  </details>

  {geral && (
    <details class="fx-subs" data-fx-recolhivel>
      <summary><h2 id={`${idPrefixo}-subs-t`}>Fluxos detalhados</h2></summary>
      <p class="muted">Algumas caixas têm um processo próprio. Cada fluxo detalhado mostra todas as etapas, as exceções aceitas e o que fica registrado.</p>
      <ul>
        {SUBFLUXOS.map((s) => (
          <li><a href={`/plataforma/fluxo/${s.id}/`} data-astro-reload>{s.titulo}</a> <span class="muted">(detalha: {tituloDe(s.no)})</span></li>
        ))}
      </ul>
    </details>
  )}

  <div class="fx-zoom cart-nao-imprimir" role="group" aria-label="Zoom do diagrama" data-fx-zoom>
    <button type="button" data-fx-zoom-menos aria-label="Diminuir o zoom">−</button>
    <output data-fx-zoom-valor aria-live="polite">100%</output>
    <button type="button" data-fx-zoom-mais aria-label="Aumentar o zoom">+</button>
    <button type="button" data-fx-zoom-ajustar>Ajustar à tela</button>
    <button type="button" data-fx-zoom-padrao>Tamanho padrão</button>
  </div>
  <div class="fx-quadro" data-fx-quadro>
    <svg class="fx-svg" viewBox={`0 0 ${LARGURA} ${ALTURA.toFixed(0)}`} role="group" aria-label={`Diagrama: ${tituloDiagrama}, do início ao fim, em raias`} preserveAspectRatio="xMidYMin meet">
      <defs>
        <marker id={`${idPrefixo}-m-fluxo`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L10 5 L0 10 Z" class="fx-seta-fluxo"/></marker>
        <marker id={`${idPrefixo}-m-apoio`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L10 5 L0 10 Z" class="fx-seta-apoio"/></marker>
      </defs>
      {RAIAS.map((r, i) => (
        <g>
          <rect x={i * COL} y="0" width={COL} height={ALTURA} class={`fx-raia ${i % 2 ? 'fx-raia-b' : 'fx-raia-a'}`}/>
          <text x={(i + 0.5) * COL} y={TOPO / 2 + 5} text-anchor="middle" class="fx-raia-nome">{r.nome}</text>
        </g>
      ))}
      <line x1="0" y1={TOPO} x2={LARGURA} y2={TOPO} class="fx-raia-linha"/>
      {ligacoes.map((l) => (
        <path d={l.d} class={`fx-lin fx-lin-${l.tipo}`} marker-end={`url(#${idPrefixo}-m-${l.tipo})`} fill="none"/>
      ))}
      {ligacoes.filter((l) => l.lab).map((l) => (
        <text x={l.lab!.x} y={l.lab!.y} text-anchor={l.lab!.ancora} class="fx-rot-lig">{l.rotulo}</text>
      ))}
      {NOS.map((n) => {
        const g = geo.get(n.id)!;
        const m = 5;
        return (
          <g class="fx-no" role="button" tabindex="0" data-no={n.id} aria-label={`${n.tipo === 'excecao' ? 'Exceção: ' : ''}${n.titulo}: ${ROTULO_SITUACAO[n.situacao]}`}>
            {n.tipo === 'decisao'
              ? <>
                  <path d={`M${g.cx} ${g.cy - g.hh - m} L${g.cx + g.hw + m} ${g.cy} L${g.cx} ${g.cy + g.hh + m} L${g.cx - g.hw - m} ${g.cy} Z`} class="fx-foco"/>
                  <path d={`M${g.cx} ${g.cy - g.hh} L${g.cx + g.hw} ${g.cy} L${g.cx} ${g.cy + g.hh} L${g.cx - g.hw} ${g.cy} Z`} class={`fx-forma fx-s-${n.situacao}`}/>
                </>
              : n.tipo === 'tarefa'
                ? <>
                    <rect x={g.cx - g.hw - m} y={g.cy - g.hh - m} width={2 * g.hw + 2 * m} height={2 * g.hh + 2 * m} rx="13" class="fx-foco"/>
                    <rect x={g.cx - g.hw} y={g.cy - g.hh} width={2 * g.hw} height={2 * g.hh} rx="9" class={`fx-forma fx-s-${n.situacao}`}/>
                  </>
                : n.tipo === 'excecao'
                  ? <>
                      <path d={hex(g, m)} class="fx-foco"/>
                      <path d={hex(g, 0)} class="fx-forma fx-exc"/>
                    </>
                  : <>
                      <circle cx={g.cx} cy={g.cy} r={g.hw + m} class="fx-foco"/>
                      <circle cx={g.cx} cy={g.cy} r={g.hw} class={`fx-forma fx-s-${n.situacao} ${n.tipo === 'fim' ? 'fx-grosso' : 'fx-fino'}`}/>
                    </>}
            {g.linhas.map((t, i) => <text x={g.cx} y={g.cy + g.yTit + i * g.passo} text-anchor="middle" class="fx-tit" style={`font-size:${g.fs}px`}>{t}</text>)}
            {n.tipo === 'excecao' && <text x={g.cx} y={g.cy + g.yExc} text-anchor="middle" class="fx-exc-rot" style={`font-size:${9 * E}px`}>exceção</text>}
            <text x={g.cx} y={g.cy + g.ySit} text-anchor="middle" class="fx-sit" style={`font-size:${9.5 * E}px`}>{rotuloSit[n.situacao]}</text>
            {g.temSub && <text x={g.cx} y={g.cy + g.ySelo} text-anchor="middle" class="fx-selo-sub" style={`font-size:${8.5 * E}px`}>+ detalhe</text>}
          </g>
        );
      })}
    </svg>
  </div>

  <section class="fx-lista" aria-labelledby={`${idPrefixo}-lista-t`}>
    <h2 id={`${idPrefixo}-lista-t`}>Lista das etapas</h2>
    <p class="muted">As mesmas etapas do diagrama, por área e na ordem do tempo. Para leitura, impressão e leitor de tela.</p>
    {RAIAS.map((r) => (
      <div class="fx-lista-raia">
        <h3>{r.nome}</h3>
        <p class="muted">{r.descricao}</p>
        <ol>
          {NOS.filter((n) => n.raia === r.id).sort((a, b) => a.linha - b.linha).map((n) => (
            <li>
              <a href={`#${idDetalhe}`} role="button" data-abrir={n.id}>{n.titulo}</a>
              <span class={`fx-pilula fx-p-${n.situacao}`}>{rotuloSit[n.situacao]}</span>
              {n.tipo === 'excecao' && <span class="fx-pilula fx-p-exc">exceção</span>}
              {subDe(n.id) && <a class="fx-ver-sub" href={`/plataforma/fluxo/${subDe(n.id)!.id}/`} data-astro-reload aria-label={`Ver fluxo detalhado: ${n.titulo}`}>Ver fluxo detalhado</a>}
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  <section class="fx-so-impressao fx-anexo" aria-hidden="true">
    <h2>Detalhe das etapas</h2>
    {RAIAS.map((r) => (
      <div class="fx-anexo-raia">
        <h3>{r.nome}</h3>
        <p>{r.descricao}</p>
        {NOS.filter((n) => n.raia === r.id).sort((a, b) => a.linha - b.linha).map((n) => (
          <article class="fx-anexo-no">
            <h4>{n.titulo}{n.tipo === 'excecao' ? ' (exceção)' : ''}</h4>
            <p><strong>Situação:</strong> {ROTULO_SITUACAO[n.situacao]} · {n.fase}</p>
            <p><strong>O que é feito:</strong> {n.oQue}</p>
            <p><strong>O que é validado:</strong> {n.valida.length ? n.valida.join('; ') + '.' : '—'}</p>
            {n.excecao && <p><strong>Exceção aceita quando:</strong> {n.excecao.aceitaQuando}</p>}
            {n.excecao && <p><strong>O que fica registrado:</strong> {n.excecao.registro}</p>}
            <p><strong>Quem:</strong> {n.quem}</p>
            <p><strong>Próximas etapas:</strong> {proximasTxt(n.id)}</p>
            <p><strong>Telas:</strong> {n.telas.map((t) => t.rotulo).join('; ')}</p>
            {subDe(n.id) && <p><strong>Fluxo detalhado:</strong> {subDe(n.id)!.titulo}</p>}
          </article>
        ))}
      </div>
    ))}
  </section>

  <dialog id={idDetalhe} class="cart-dialogo fx-dialogo" aria-labelledby={`${idPrefixo}-d-titulo`}>
    <h2 id={`${idPrefixo}-d-titulo`} data-fx-titulo></h2>
    <p data-fx-situacao></p>
    <p data-fx-raia></p>
    <h3>O que é feito</h3>
    <p data-fx-oque></p>
    <h3>O que é validado</h3>
    <ul data-fx-valida></ul>
    <div data-fx-exc hidden>
      <h3>Exceção</h3>
      <p><strong>Aceita quando:</strong> <span data-fx-exc-quando></span></p>
      <p><strong>O que fica registrado:</strong> <span data-fx-exc-registro></span></p>
    </div>
    <h3>Quem</h3>
    <p data-fx-quem></p>
    <h3>Etapas anteriores</h3>
    <ul data-fx-ant></ul>
    <h3>Próximas etapas</h3>
    <ul data-fx-prox></ul>
    <h3>Telas</h3>
    <ul data-fx-telas class="fx-telas"></ul>
    <p data-fx-sub hidden><a class="button primary" data-astro-reload href="/plataforma/projetos-fluxo/">Ver fluxo detalhado</a></p>
    <div class="fx-d-acoes"><button type="button" data-fx-fechar>Fechar</button></div>
  </dialog>
  <script type="application/json" data-fx-dados set:html={dadosJson}></script>
</div>

<script>
document.addEventListener('astro:page-load', () => {
  const raiz = document.querySelector<HTMLElement>('[data-fluxo]');
  const dlg = raiz?.querySelector<HTMLDialogElement>('dialog') ?? null;
  const fonte = raiz?.querySelector('[data-fx-dados]') ?? null;
  if (!raiz || !dlg || !fonte || raiz.dataset.pronto) return;
  // ——— Zoom: 100% = 1 unidade do desenho por pixel (o diagrama geral fica com 1000 px de largura).
  // "Ajustar" = largura do quadro. Acima da largura do quadro, a rolagem é dentro do quadro (a página não rola de lado).
  {
    const svg = raiz.querySelector<SVGSVGElement>('.fx-svg');
    const quadro = raiz.querySelector<HTMLElement>('[data-fx-quadro]');
    const valor = raiz.querySelector<HTMLOutputElement>('[data-fx-zoom-valor]');
    const NIVEIS = [0.5, 0.6, 0.7, 0.8, 0.9, 1, 1.1, 1.25, 1.5, 1.75, 2];
    const CHAVE = 'govnexa-fluxo-zoom';
    const largura = svg ? svg.viewBox.baseVal.width : 0;
    let modo: 'ajustar' | number = 1;
    let guardado = false; // só conta preferência válida
    try {
      const g = localStorage.getItem(CHAVE);
      if (g === 'ajustar') {
        modo = 'ajustar';
        guardado = true;
      } else if (g && NIVEIS.includes(Number(g))) {
        modo = Number(g);
        guardado = true;
      }
    } catch {}
    // Quadro escondido (largura 0) não zera o desenho: fica em 100% até ter largura.
    const ajuste = () => (quadro && largura && quadro.clientWidth > 0 ? quadro.clientWidth / largura : 1);
    // Sem preferência guardada: 100%, ou ajustar quando a tela é mais estreita que o diagrama (celular).
    const efetivo = () => (modo === 'ajustar' ? ajuste() : modo);
    const aplicar = () => {
      if (!svg || !largura) return;
      const z = efetivo();
      svg.style.width = `${Math.round(largura * z)}px`;
      svg.style.maxWidth = 'none';
      svg.style.margin = '0 auto';
      if (valor) valor.textContent = `${Math.round(z * 100)}%`;
      raiz.querySelector<HTMLButtonElement>('[data-fx-zoom-menos]')!.disabled = z <= NIVEIS[0] + 0.001;
      raiz.querySelector<HTMLButtonElement>('[data-fx-zoom-mais]')!.disabled = z >= NIVEIS[NIVEIS.length - 1] - 0.001;
    };
    const guardar = () => {
      try {
        localStorage.setItem(CHAVE, String(modo));
      } catch {}
    };
    const passo = (dir: 1 | -1) => {
      const z = efetivo();
      const prox = dir > 0 ? NIVEIS.find((n) => n > z + 0.001) : [...NIVEIS].reverse().find((n) => n < z - 0.001);
      if (prox === undefined) return;
      modo = prox;
      guardar();
      aplicar();
    };
    if (!guardado && ajuste() < 1) modo = 'ajustar';
    raiz.querySelector('[data-fx-zoom-menos]')?.addEventListener('click', () => passo(-1));
    raiz.querySelector('[data-fx-zoom-mais]')?.addEventListener('click', () => passo(1));
    raiz.querySelector('[data-fx-zoom-ajustar]')?.addEventListener('click', () => {
      modo = 'ajustar';
      guardar();
      aplicar();
    });
    raiz.querySelector('[data-fx-zoom-padrao]')?.addEventListener('click', () => {
      modo = 1;
      guardar();
      aplicar();
    });
    // Ctrl + roda do mouse sobre o diagrama também aproxima e afasta.
    // Pinça do trackpad manda muitos eventos pequenos: acumula e dá no máximo um passo a cada 120 ms.
    let acumulado = 0;
    let ultimo = 0;
    quadro?.addEventListener('wheel', (ev) => {
      if (!ev.ctrlKey) return;
      ev.preventDefault();
      acumulado += ev.deltaY;
      const agora = performance.now();
      if (Math.abs(acumulado) < 40 || agora - ultimo < 120) return;
      passo(acumulado < 0 ? 1 : -1);
      acumulado = 0;
      ultimo = agora;
    }, { passive: false });
    window.addEventListener('resize', () => {
      if (modo === 'ajustar') aplicar();
    });
    aplicar();
  }
  // Legenda e fluxos detalhados começam recolhidos na tela; na impressão/PDF saem abertos e depois voltam como estavam.
  {
    const recolhiveis = [...raiz.querySelectorAll<HTMLDetailsElement>('[data-fx-recolhivel]')];
    let antes: boolean[] = [];
    window.addEventListener('beforeprint', () => {
      antes = recolhiveis.map((d) => d.open);
      for (const d of recolhiveis) d.open = true;
    });
    window.addEventListener('afterprint', () => recolhiveis.forEach((d, i) => (d.open = antes[i] ?? false)));
  }
  raiz.querySelector<HTMLButtonElement>('[data-fx-pdf]')?.addEventListener('click', () => {
    const hoje = new Date();
    const alvo = raiz.querySelector('[data-fx-data-impressao]');
    if (alvo) alvo.textContent = 'gerado em ' + hoje.toLocaleDateString('pt-BR');
    const tituloAntes = document.title;
    document.title = (raiz.dataset.fxTituloPdf || 'Fluxo do sistema') + ' - GovNexa - ' + hoje.toISOString().slice(0, 10);
    window.addEventListener('afterprint', () => { document.title = tituloAntes; }, { once: true });
    window.print();
  });
  raiz.dataset.pronto = 'sim';
  interface Lig { id: string; titulo: string; rotulo: string }
  interface No { id: string; tipo: string; titulo: string; situacao: string; fase: string; raia: string; oQue: string; valida: string[]; quem: string; anteriores: Lig[]; proximas: Lig[]; telas: { rotulo: string; url: string }[]; excecao: { aceitaQuando: string; registro: string } | null; subfluxo: string | null }
  const nos: No[] = JSON.parse(fonte.textContent || '[]');
  const q = <T extends HTMLElement>(s: string) => dlg.querySelector<T>(s)!;

  const itens = (ul: HTMLElement, lista: string[]) => {
    ul.replaceChildren();
    if (!lista.length) { const li = document.createElement('li'); li.textContent = 'Nenhuma.'; ul.append(li); return; }
    for (const t of lista) { const li = document.createElement('li'); li.textContent = t; ul.append(li); }
  };
  const vizinhas = (ul: HTMLElement, lista: Lig[]) => {
    ul.replaceChildren();
    if (!lista.length) { const li = document.createElement('li'); li.textContent = 'Nenhuma.'; ul.append(li); return; }
    for (const l of lista) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'fx-vizinha';
      b.dataset.irPara = l.id;
      b.textContent = l.titulo;
      li.append(b);
      if (l.rotulo) li.append(document.createTextNode(' (' + l.rotulo + ')'));
      ul.append(li);
    }
  };
  const preencher = (id: string) => {
    const n = nos.find((x) => x.id === id);
    if (!n) return;
    q('[data-fx-titulo]').textContent = n.titulo;
    q('[data-fx-situacao]').textContent = 'Situação: ' + n.situacao + ' · ' + n.fase;
    q('[data-fx-raia]').textContent = 'Raia: ' + n.raia;
    q('[data-fx-oque]').textContent = n.oQue;
    itens(q('[data-fx-valida]'), n.valida);
    q('[data-fx-quem]').textContent = n.quem;
    const exc = q('[data-fx-exc]');
    exc.hidden = !n.excecao;
    q('[data-fx-exc-quando]').textContent = n.excecao?.aceitaQuando ?? '';
    q('[data-fx-exc-registro]').textContent = n.excecao?.registro ?? '';
    vizinhas(q('[data-fx-ant]'), n.anteriores);
    vizinhas(q('[data-fx-prox]'), n.proximas);
    const ul = q('[data-fx-telas]');
    ul.replaceChildren();
    for (const t of n.telas) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'button secondary';
      a.setAttribute('data-astro-reload', '');
      a.href = t.url;
      a.textContent = 'Abrir: ' + t.rotulo;
      li.append(a);
      ul.append(li);
    }
    const sub = q('[data-fx-sub]');
    sub.hidden = !n.subfluxo;
    if (n.subfluxo) q<HTMLAnchorElement>('[data-fx-sub] a').href = '/plataforma/fluxo/' + encodeURIComponent(n.subfluxo) + '/';
  };
  const abrir = (id: string) => {
    preencher(id);
    if (!dlg.open) dlg.showModal();
    dlg.scrollTop = 0;
  };

  raiz.querySelectorAll<SVGGElement>('[data-no]').forEach((g) => {
    g.addEventListener('click', () => abrir(g.dataset.no!));
    g.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrir(g.dataset.no!); }
    });
  });
  raiz.querySelectorAll<HTMLElement>('[data-abrir]').forEach((a) => {
    a.addEventListener('click', (e) => { e.preventDefault(); abrir(a.dataset.abrir!); });
    a.addEventListener('keydown', (e) => {
      if (e.key === ' ') { e.preventDefault(); abrir(a.dataset.abrir!); }
    });
  });
  dlg.addEventListener('click', (e) => {
    const alvo = e.target as HTMLElement;
    const ir = alvo.closest<HTMLElement>('[data-ir-para]');
    if (ir) { preencher(ir.dataset.irPara!); dlg.scrollTop = 0; q('[data-fx-titulo]').setAttribute('tabindex', '-1'); q('[data-fx-titulo]').focus(); return; }
    if (alvo.closest('[data-fx-fechar]')) dlg.close();
  });
});
</script>
