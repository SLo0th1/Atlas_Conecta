---
import {getCollection} from 'astro:content';
const {tipo=''}=Astro.props;
const entries=(await getCollection('insights')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
---
<div data-insights data-initial={tipo}><div class="filters insight-filters"><label for="insight-search">Buscar conteúdo</label><input id="insight-search" type="search" data-search placeholder="Buscar conteúdo"/><label for="insight-type">Tipo</label><select id="insight-type" data-type><option value="">Todos os tipos</option>{['artigo','estudo-de-caso','guia','boletim'].map(t=><option value={t} selected={tipo===t}>{t}</option>)}</select><label for="insight-tag">Tag</label><select id="insight-tag" data-tag><option value="">Todas as tags</option>{[...new Set(entries.flatMap(e=>e.data.tags))].map(t=><option>{t}</option>)}</select></div><p data-count role="status"></p><div class="grid">{entries.map(e=><article class="card" data-entry data-type={e.data.tipo} data-tags={e.data.tags.join('|')} data-text={`${e.data.title} ${e.data.resumo} ${e.data.tags.join(' ')}`}><span class="pill">{e.data.tipo}</span><p><time datetime={e.data.date.toISOString()}>{e.data.date.toLocaleDateString('pt-BR',{timeZone:'UTC'})}</time></p><h3><a href={`/insights/${e.id}/`}>{e.data.title}</a></h3><p>{e.data.resumo}</p><small>{e.data.tags.join(' · ')}</small></article>)}</div><p data-empty hidden>Nenhum conteúdo encontrado. Experimente outros filtros.</p><div class="pagination"><button data-prev>Anterior</button><span data-page></span><button data-next>Próxima</button></div></div>
<script>
 document.querySelectorAll<HTMLElement>('[data-insights]').forEach(root=>{const search=root.querySelector<HTMLInputElement>('[data-search]')!,type=root.querySelector<HTMLSelectElement>('[data-type]')!,tag=root.querySelector<HTMLSelectElement>('[data-tag]')!,cards=[...root.querySelectorAll<HTMLElement>('[data-entry]')];search.value=new URLSearchParams(location.search).get('q')||'';let page=1;const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();function update(){const matches=cards.filter(c=>(!type.value||c.dataset.type===type.value)&&(!tag.value||c.dataset.tags?.split('|').includes(tag.value))&&normalize(c.dataset.text||'').includes(normalize(search.value)));const pages=Math.max(1,Math.ceil(matches.length/6));page=Math.min(page,pages);cards.forEach(c=>c.hidden=true);matches.slice((page-1)*6,page*6).forEach(c=>c.hidden=false);root.querySelector('[data-count]')!.textContent=`${matches.length} conteúdos encontrados`;root.querySelector<HTMLElement>('[data-empty]')!.hidden=matches.length>0;root.querySelector('[data-page]')!.textContent=`Página ${page} de ${pages}`;root.querySelector<HTMLButtonElement>('[data-prev]')!.disabled=page===1;root.querySelector<HTMLButtonElement>('[data-next]')!.disabled=page===pages;}[search,type,tag].forEach(el=>el.addEventListener('input',()=>{page=1;update()}));root.querySelector('[data-prev]')!.addEventListener('click',()=>{page--;update()});root.querySelector('[data-next]')!.addEventListener('click',()=>{page++;update()});update();});
</script>
