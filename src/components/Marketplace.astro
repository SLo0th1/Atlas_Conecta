---
import offers from '../data/offers.json';const {basket=false}=Astro.props;
---
<div data-market data-basket={String(basket)}><div class="filters"><label>Buscar ofertas<input data-offer-search type="search" placeholder="Buscar ofertas"/></label><label>Tipo de oferta<select data-offer-type><option value="">Todos</option><option>Produto</option><option>Serviço</option></select></label><label>Categoria<select data-offer-category><option value="">Todas</option><option>Alimentos</option><option>Saúde</option><option>Infraestrutura</option><option>Educação</option><option>Administração</option></select></label><label>UF atendida<select data-offer-uf><option value="">Todas</option><option>GO</option><option>DF</option></select></label><label><span><input type="checkbox" data-national/> Atendimento nacional</span></label></div><p role="status" data-offer-count></p><div class="offer-grid">{offers.map(o=><article class="card" data-offer data-id={o.id} data-title={o.title} data-type={o.type} data-category={o.category} data-uf={o.uf} data-provider={o.provider} data-national={String(o.national)}><span class="pill">{o.type} · {o.uf}</span><h3><a href={`/plataforma/oferta-${o.id}/`}>{o.title}</a></h3><p>{o.provider}</p><p>{o.category}</p><strong>{o.price.toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}</strong><p><button data-add={o.id} data-prototype>{basket?'Remover da cotação':'Adicionar à cotação'}</button></p></article>)}</div><p data-offer-empty hidden>Nenhuma oferta encontrada. A cesta dura apenas durante esta navegação.</p><p><a href="/plataforma/minha-cotacao/">Minha cotação →</a></p>{basket&&<form data-prototype-form class="form-grid"><label>Prazo desejado *<input type="date" required/></label><label>Local de entrega / execução *<textarea required></textarea></label><label>Observações<textarea></textarea></label><button data-prototype>Solicitar propostas</button></form>}</div>
<script>
const root=document.querySelector<HTMLElement>('[data-market]');if(root){let basket:number[]=[];try{basket=JSON.parse(sessionStorage.getItem('atlas-basket')||'[]')}catch{}const cards=[...root.querySelectorAll<HTMLElement>('[data-offer]')],inputs=[...root.querySelectorAll<HTMLInputElement|HTMLSelectElement>('.filters input,.filters select')];function update(){let n=0;cards.forEach(c=>{const q=inputs[0].value.toLowerCase();const match=(!q||`${c.dataset.title} ${c.dataset.provider}`.toLowerCase().includes(q))&&(!inputs[1].value||inputs[1].value===c.dataset.type)&&(!inputs[2].value||inputs[2].value===c.dataset.category)&&(!inputs[3].value||inputs[3].value===c.dataset.uf)&&(!(inputs[4] as HTMLInputElement).checked||c.dataset.national==='true')&&(root!.dataset.basket!=='true'||basket.includes(Number(c.dataset.id)));c.hidden=!match;if(match)n++});root!.querySelector('[data-offer-count]')!.textContent=`${n} ofertas · dados de exemplo`;root!.querySelector<HTMLElement>('[data-offer-empty]')!.hidden=n>0;}inputs.forEach(i=>i.addEventListener('input',update));root.querySelectorAll<HTMLButtonElement>('[data-add]').forEach(b=>b.addEventListener('click',()=>{const id=Number(b.dataset.add);if(root.dataset.basket==='true')basket=basket.filter(v=>v!==id);else if(!basket.includes(id))basket.push(id);try{sessionStorage.setItem('atlas-basket',JSON.stringify(basket))}catch{}b.textContent=root.dataset.basket==='true'?'Removido':'Adicionado à cotação';update()}));update();}
</script>