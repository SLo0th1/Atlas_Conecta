---
import Base from './Base.astro';import Icon from '../components/Icon.astro';import modules from '../data/modules.json';const {title,slug}=Astro.props;const menuIcons:Record<string,string>={"": "layout-grid", "processos": "briefcase", "cotacoes": "receipt", "solicitacoes": "inbox", "recursos": "message-square", "diligencias": "search-check", "documentos": "sparkles", "captacao": "trend", "captacao-oportunidades": "search", "captacao-acompanhamento": "gauge", "captacao-alertas": "bell", "captacao-qualidade": "database", "captacao-comparativo": "bar-chart", "captacao-projetos": "clipboard-check", "gestao-publica": "gauge", "pareceres": "clipboard-check", "banco-de-precos": "database", "atas": "archive", "piloto-automatico": "zap", "marketplace": "store", "produtos": "package", "fornecedores": "users", "enderecos": "map-pin", "locais-de-entrega": "truck", "relatorios": "bar-chart", "perfil": "user", "configuracoes": "settings", "minha-cotacao": "receipt", "pedidos": "inbox", "negociacoes": "message-square", "embarcacoes": "truck"};const groups=[...new Set(modules.map(m=>m.group))];
---
<Base platform title={title} description={`Explore ${title} com dados fictícios de Goiânia.`}><div class="platform"><aside id="platform-drawer" class="sidebar" transition:persist="sidebar" aria-label="Módulos da plataforma"><div class="sidebar-top"><img class="logo-card" src="/brand/prefeitura-goiania.png" alt="Prefeitura de Goiânia" width="164" height="55"/><button id="sidebar-toggle" aria-label="Recolher menu" aria-expanded="true" aria-controls="side-links"><Icon name="menu"/></button></div><div class="side-links" id="side-links"><p class="eyebrow">Área do comprador</p>{groups.map(g=><div><h2>{g}</h2>{modules.filter(m=>m.group===g).map(m=><a href={`/plataforma/${m.slug?m.slug+'/':''}`} aria-current={m.slug===slug?'page':undefined} aria-label={m.title} title={m.title}><Icon name={menuIcons[m.slug]}/><span class="side-label">{m.title}</span>{['solicitacoes','pareceres','recursos'].includes(m.slug)&&<span class="badge">3</span>}<span class="side-tooltip" aria-hidden="true">{m.title}</span></a>)}</div>)}</div><a class="sidebar-help" aria-label="Precisa de ajuda? Fale com o suporte" href="/sobre/#contato"><Icon name="help"/><span class="side-label">Precisa de ajuda?<small>Fale com o suporte</small></span></a></aside><div class="workspace"><p class="notice">Ambiente de homologação · dados de exemplo · nada é gravado.</p><slot/></div></div><div id="toast" class="toast" role="status" hidden></div><dialog id="record-dialog"><h2>Detalhes do registro</h2><div id="record-body" style="max-height:70vh;overflow:auto"></div><form method="dialog"><button><Icon name="x" size={16}/>Fechar</button></form></dialog></Base>
<script>
document.addEventListener('astro:page-load',()=>{

const lifecycle=new AbortController();document.addEventListener('astro:before-swap',()=>lifecycle.abort(),{once:true});
const drawer=document.querySelector<HTMLButtonElement>('#drawer-toggle')!;
const sidebar=document.querySelector<HTMLElement>('.sidebar')!;if(!drawer||!sidebar)return;
sidebar.querySelectorAll('a').forEach(a=>a.setAttribute('aria-current',new URL(a.href).pathname===location.pathname?'page':'false'));
const label=document.querySelector('[data-module-title]');if(label)label.textContent=document.title.split(' | ')[0];
function closeDrawer(){sidebar.classList.remove('drawer-open');drawer.setAttribute('aria-expanded','false');}
drawer.onclick=()=>{const open=drawer.getAttribute('aria-expanded')==='true';closeDrawer();if(!open){sidebar.classList.add('drawer-open');drawer.setAttribute('aria-expanded','true');sidebar.querySelector<HTMLElement>('button,a')?.focus();}};
document.addEventListener('keydown',e=>{if(drawer.getAttribute('aria-expanded')!=='true')return;if(e.key==='Escape'){closeDrawer();drawer.focus();}if(e.key==='Tab'){const nodes=[drawer,...sidebar.querySelectorAll<HTMLElement>('button,a')].filter(n=>n.getClientRects().length);const i=nodes.indexOf(document.activeElement as HTMLElement);e.preventDefault();nodes[(i+(e.shiftKey?-1:1)+nodes.length)%nodes.length].focus();}},{signal:lifecycle.signal});
const query=new URLSearchParams(location.search).get('q');const search=document.querySelector<HTMLInputElement>('[data-table-search]');if(query&&search){search.value=query;requestAnimationFrame(()=>search.dispatchEvent(new Event('input')));}
const b=document.querySelector<HTMLButtonElement>('#sidebar-toggle')!;b.onclick=()=>{const closed=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!closed));b.setAttribute('aria-label',closed?'Expandir menu':'Recolher menu');try{localStorage.setItem('atlas-sidebar',String(closed))}catch{};document.querySelector('.sidebar')?.setAttribute('data-closed',String(closed));document.querySelector('.platform')?.classList.toggle('collapsed',closed)};
document.querySelector('.platform')?.classList.toggle('collapsed',b.getAttribute('aria-expanded')==='false');
try{if(localStorage.getItem('atlas-sidebar')==='true'&&b.getAttribute('aria-expanded')==='true')b.click()}catch{};
let timer:ReturnType<typeof setTimeout>;document.addEventListener('astro:before-swap',()=>clearTimeout(timer),{once:true});document.addEventListener('click',e=>{const target=e.target as HTMLElement;if(target.closest('[data-prototype]')){const toast=document.querySelector<HTMLElement>('#toast')!;toast.textContent='protótipo: nada é gravado';toast.hidden=false;clearTimeout(timer);timer=setTimeout(()=>toast.hidden=true,3000);}const detail=target.closest('[data-detail]');if(detail){const row=detail.closest<HTMLElement>('[data-row]')!;const vals:Array<string|number>=JSON.parse(row.dataset.values!);const heads=[...row.closest('table')!.querySelectorAll('thead th')];const body=document.querySelector('#record-body')!;body.replaceChildren();const det=row.dataset.detalhe?JSON.parse(row.dataset.detalhe):null;if(det){const h=document.createElement('h3');h.textContent=det.titulo;body.append(h);for(const s of det.secoes){const t=document.createElement('h4');t.textContent=s.titulo;body.append(t);if(s.texto){const q=document.createElement('p');q.textContent=s.texto;body.append(q)}if(s.itens){const ul=document.createElement('ul');for(const it of s.itens){const li=document.createElement('li');li.textContent=it;ul.append(li)}body.append(ul)}}const lks=[...(det.links??[]),...(det.link?[det.link]:[])].filter((l:{url:string})=>String(l.url).startsWith("https://"));if(lks.length){const ul=document.createElement('ul');for(const l of lks){const li=document.createElement('li');const a=document.createElement('a');a.href=l.url;a.textContent=l.rotulo;a.target='_blank';a.rel='noopener noreferrer';li.append(a);ul.append(li)}body.append(ul)}document.querySelector<HTMLDialogElement>('#record-dialog')!.showModal();return;}vals.forEach((v,i)=>{const p=document.createElement('p');p.textContent=`${heads[i].textContent?.replace(' ↕','')}: ${v}`;body.append(p)});document.querySelector<HTMLDialogElement>('#record-dialog')!.showModal();}},{signal:lifecycle.signal});
document.querySelectorAll<HTMLFormElement>('[data-prototype-form]').forEach(f=>f.addEventListener('submit',e=>{e.preventDefault();document.querySelector<HTMLElement>('#toast')!.textContent='protótipo: nada é gravado';document.querySelector<HTMLElement>('#toast')!.hidden=false;clearTimeout(timer);timer=setTimeout(()=>{const toast=document.querySelector<HTMLElement>('#toast');if(toast)toast.hidden=true},3000)}));

});
</script>