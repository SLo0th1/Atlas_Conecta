---
import Base from './Base.astro';import modules from '../data/modules.json';const {title,slug}=Astro.props;const groups=[...new Set(modules.map(m=>m.group))];
---
<Base platform title={title} description={`Explore ${title} com dados fictícios de Goiânia.`}><div class="platform"><aside id="platform-drawer" class="sidebar" aria-label="Módulos da plataforma"><button id="sidebar-toggle" aria-expanded="true" aria-controls="side-links">Recolher menu</button><div class="side-links" id="side-links"><p class="eyebrow">Área do comprador</p>{groups.map(g=><div><h2>{g}</h2>{modules.filter(m=>m.group===g).map(m=><a href={`/plataforma/${m.slug?m.slug+'/':''}`} aria-current={m.slug===slug?'page':undefined}>{m.title}</a>)}</div>)}</div></aside><div class="workspace"><p class="eyebrow">Prefeitura de Goiânia / ambiente demonstrativo</p><p class="notice"><strong>Dados de exemplo</strong> · protótipo: nada é gravado. Sem vínculo oficial com a Prefeitura.</p><slot/></div></div><div id="toast" class="toast" role="status" hidden></div><dialog id="record-dialog"><h2>Detalhes do registro</h2><div id="record-body"></div><form method="dialog"><button>Fechar</button></form></dialog></Base>
<script>
const drawer=document.querySelector<HTMLButtonElement>('#drawer-toggle')!;
const sidebar=document.querySelector<HTMLElement>('.sidebar')!;
function closeDrawer(){sidebar.classList.remove('drawer-open');drawer.setAttribute('aria-expanded','false');}
drawer.addEventListener('click',()=>{const open=drawer.getAttribute('aria-expanded')==='true';closeDrawer();if(!open){sidebar.classList.add('drawer-open');drawer.setAttribute('aria-expanded','true');sidebar.querySelector<HTMLElement>('button,a')?.focus();}});
document.addEventListener('keydown',e=>{if(drawer.getAttribute('aria-expanded')!=='true')return;if(e.key==='Escape'){closeDrawer();drawer.focus();}if(e.key==='Tab'){const nodes=[drawer,...sidebar.querySelectorAll<HTMLElement>('button,a')].filter(n=>n.getClientRects().length);const i=nodes.indexOf(document.activeElement as HTMLElement);e.preventDefault();nodes[(i+(e.shiftKey?-1:1)+nodes.length)%nodes.length].focus();}});
const query=new URLSearchParams(location.search).get('q');const search=document.querySelector<HTMLInputElement>('[data-table-search]');if(query&&search){search.value=query;search.dispatchEvent(new Event('input'));}
const b=document.querySelector<HTMLButtonElement>('#sidebar-toggle')!;b.addEventListener('click',()=>{const closed=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!closed));b.textContent=closed?'Expandir menu':'Recolher menu';document.querySelector('.sidebar')?.setAttribute('data-closed',String(closed));document.querySelector('.platform')?.classList.toggle('collapsed',closed)});
let timer:ReturnType<typeof setTimeout>;document.addEventListener('click',e=>{const target=e.target as HTMLElement;if(target.closest('[data-prototype]')){const toast=document.querySelector<HTMLElement>('#toast')!;toast.textContent='protótipo: nada é gravado';toast.hidden=false;clearTimeout(timer);timer=setTimeout(()=>toast.hidden=true,5000);}const detail=target.closest('[data-detail]');if(detail){const row=detail.closest<HTMLElement>('[data-row]')!;const vals:Array<string|number>=JSON.parse(row.dataset.values!);const heads=[...row.closest('table')!.querySelectorAll('thead th')];const body=document.querySelector('#record-body')!;body.replaceChildren();vals.forEach((v,i)=>{const p=document.createElement('p');p.textContent=`${heads[i].textContent?.replace(' ↕','')}: ${v}`;body.append(p)});document.querySelector<HTMLDialogElement>('#record-dialog')!.showModal();}});
document.querySelectorAll<HTMLFormElement>('[data-prototype-form]').forEach(f=>f.addEventListener('submit',e=>{e.preventDefault();document.querySelector<HTMLElement>('#toast')!.textContent='protótipo: nada é gravado';document.querySelector<HTMLElement>('#toast')!.hidden=false}));
</script>