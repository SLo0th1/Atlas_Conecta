---
import '../styles/global.css';
const {title,description='Conectamos necessidades públicas, empresas e fornecedores locais em Goiânia.',article=false,platform=false} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | Atlas Goiânia Conecta</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/social.svg',Astro.site)}/><meta name="theme-color" content="#123e38"/><link rel="icon" href="/favicon.svg"/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('atlas-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'Atlas Goiânia Conecta',url:Astro.site})}/><slot name="head"/></head><body><a class="skip" href="#conteudo">Pular para o conteúdo</a>{platform?(<header class="appbar"><a class="brand" href="/plataforma/" aria-label="Atlas — painel"><span class="mark">A</span></a><button id="drawer-toggle" aria-expanded="false" aria-controls="platform-drawer">Módulos</button><button id="search-toggle" aria-label="Expandir busca" aria-expanded="false" aria-controls="platform-search">⌕</button><span class="app-org">Prefeitura de Goiânia · demonstração</span><form action="/plataforma/" class="global-search" id="platform-search"><label class="sr-only" for="global-search">Busca global</label><input id="global-search" name="q" type="search" placeholder="Buscar na plataforma"/><button>Buscar</button></form><details class="app-notifications"><summary aria-label="Notificações: 3 não lidas"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path d="M5 17h14l-2-3V9a5 5 0 0 0-10 0v5zM10 21h4" fill="none" stroke="currentColor" stroke-width="2"/></svg> 3</summary><div class="submenu"><p>3 notificações de exemplo</p><p>Revise os prazos da carteira e as solicitações em análise.</p></div></details><details class="app-user"><summary aria-label="Equipe Goiânia"><span class="avatar">EG</span><span class="user-name">Equipe Goiânia</span></summary><div class="submenu"><a href="/plataforma/perfil/">Meu perfil</a><a href="/plataforma/configuracoes/">Configurações</a><a href="/api/logout/">Sair da demonstração</a><button id="theme" aria-label="Alternar tema claro e escuro">◐ Tema</button></div></details></header>):(<header class="header"><a class="brand" href="/" aria-label="Atlas Goiânia Conecta — início"><span class="mark">A</span><span>ATLAS<small>GOIÂNIA CONECTA</small></span></a><button id="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu</button><nav id="navigation" aria-label="Principal"><a href="/">Início</a><details><summary>Soluções <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="m2 4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="submenu"><a href="/compradores/">Compradores</a><a href="/setor-publico/">Setor público</a><a href="/fornecedores/">Fornecedores</a></div></details><a href="/insights/">Insights</a><a href="/sobre/">Sobre</a><a href="/plataforma/">Acessar plataforma</a><a class="button" href="/demonstracao/">Solicitar demonstração</a></nav><button id="theme" aria-label="Alternar tema claro e escuro">◐ <span>Tema</span></button></header>)}<main id="conteudo" tabindex="-1">{!platform&&Astro.url.pathname!=='/'&&<div class="breadcrumb"><a href="/">Início</a><span aria-hidden="true"> / </span><span>{title}</span></div>}<slot/></main>{platform?<footer class="app-footer">Atlas Goiânia Conecta · Dados de exemplo · <a href="/">Voltar ao site</a></footer>:<footer><div class="footer-grid"><div><a class="brand" href="/">Atlas Goiânia Conecta</a><p>Um território de boas conexões.<br/>Planejar. Conectar. Transformar.</p><small>Projeto independente · demonstração</small></div><div><h2>Explore</h2><a href="/compradores/">Compradores</a><a href="/setor-publico/">Setor público</a><a href="/fornecedores/">Fornecedores</a><a href="/insights/">Insights</a></div><div><h2>Converse com a gente</h2><a href="mailto:contato@atlas-goiania.example">contato@atlas-goiania.example</a><p>WhatsApp de exemplo: (62) 00000-0000</p><a href="/sobre/">Sobre</a><a href="/privacidade/">Privacidade</a><a href="/termos/">Termos de uso</a></div></div><p class="fine">© 2026 Atlas Goiânia Conecta. Dados e contatos ilustrativos.</p></footer>}<script src="../scripts/global.ts"></script></body></html>
