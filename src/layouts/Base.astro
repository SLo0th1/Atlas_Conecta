---
import '../styles/global.css';
import '../styles/visual.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import {ClientRouter} from 'astro:transitions';
import Icon from '../components/Icon.astro';
const {title,description='Conectamos necessidades públicas, empresas e fornecedores locais em Goiânia.',article=false,platform=false} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | Atlas Goiânia Conecta</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/social.svg',Astro.site)}/><meta name="theme-color" content="#123e38"/><link rel="icon" href="/favicon.svg"/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('atlas-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'Atlas Goiânia Conecta',url:Astro.site})}/><ClientRouter /><slot name="head"/></head><body><a class="skip" href="#conteudo">Pular para o conteúdo</a>{platform?(<header class="appbar" transition:persist="appbar"><a class="brand" data-astro-reload href="/plataforma/" aria-label="Atlas — painel"><span class="mark">A</span></a><button id="drawer-toggle" aria-expanded="false" aria-controls="platform-drawer"><Icon name="menu" size={16}/>Módulos</button><button id="search-toggle" aria-label="Expandir busca" aria-expanded="false" aria-controls="platform-search"><Icon name="search"/></button><div class="app-org"><small>CENTRAL DE OPERAÇÕES</small><strong data-module-title>{title}</strong></div><form data-astro-reload action="/plataforma/" class="global-search" id="platform-search"><label class="sr-only" for="global-search">Busca global</label><Icon name="search"/><input id="global-search" name="q" type="search" placeholder="Buscar na plataforma"/><button>Buscar</button></form><details class="app-notifications"><summary aria-label="Notificações: 3 não lidas"><Icon name="bell" size={18}/> <span class="badge">3</span></summary><div class="submenu"><p>3 notificações de exemplo</p><p>Revise os prazos da carteira e as solicitações em análise.</p></div></details><details class="app-user"><summary aria-label="Equipe Goiânia"><span class="avatar">EG</span><span class="user-name">Equipe Goiânia</span></summary><div class="submenu"><a data-astro-reload href="/plataforma/perfil/">Meu perfil</a><a data-astro-reload href="/plataforma/configuracoes/">Configurações</a><a data-astro-reload href="/api/logout/"><Icon name="log-out"/>Sair da demonstração</a><button id="theme" aria-label="Alternar tema claro e escuro"><Icon name="sun"/><Icon name="moon"/>Tema</button></div></details></header>):(<header class="header"><a class="brand" href="/"><img class="municipal-logo" src="/brand/prefeitura-goiania.png" alt="Prefeitura de Goiânia" width="131" height="44"/><span class="brand-name">Atlas Conecta</span></a><button id="menu-toggle" aria-expanded="false" aria-controls="navigation"><Icon name="menu" size={16}/>Menu</button><nav id="navigation" aria-label="Principal"><a href="/">Início</a><details><summary>Soluções <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="m2 4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary><div class="submenu"><a href="/compradores/"><Icon name="box"/>Compradores</a><a href="/setor-publico/"><Icon/>Setor público</a><a href="/fornecedores/"><Icon name="users"/>Fornecedores</a></div></details><a href="/insights/">Insights</a><a href="/sobre/">Sobre</a><a class="button secondary" data-astro-reload href="/plataforma/" data-astro-reload>Acessar plataforma</a><a class="button primary" href="/demonstracao/">Solicitar demonstração</a></nav><button id="theme" aria-label="Alternar tema claro e escuro"><Icon name="sun"/><Icon name="moon"/> <span>Tema</span></button></header>)}<main id="conteudo" tabindex="-1">{!platform&&Astro.url.pathname!=='/'&&<div class="breadcrumb"><a href="/">Início</a><span aria-hidden="true"> / </span><span>{title}</span></div>}<slot/></main>{platform?<footer class="app-footer">Atlas Goiânia Conecta · Dados de exemplo · <a href="/">Voltar ao site</a></footer>:<footer><div class="footer-grid"><div><a class="brand" href="/"><img class="logo-card" src="/brand/prefeitura-goiania.png" alt="Prefeitura de Goiânia" width="200" height="67"/></a><p>Um território de boas conexões.<br/>Planejar. Conectar. Transformar.</p><small>Ambiente de homologação · dados de exemplo</small></div><div><h2>Explore</h2><a href="/compradores/">Compradores</a><a href="/setor-publico/">Setor público</a><a href="/fornecedores/">Fornecedores</a><a href="/insights/">Insights</a></div><div><h2>Converse com a gente</h2><a href="mailto:contato@atlas-goiania.example">contato@atlas-goiania.example</a><p>WhatsApp de exemplo: (62) 00000-0000</p><a href="/sobre/">Sobre</a><a href="/privacidade/">Privacidade</a><a href="/termos/">Termos de uso</a></div></div><p class="fine">© 2026 Atlas Goiânia Conecta. Dados e contatos ilustrativos.</p></footer>}<script src="../scripts/global.ts"></script></body></html>
