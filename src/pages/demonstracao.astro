---
import Base from '../layouts/Base.astro';
---
<Base title="Solicitar demonstração"><section class="prose"><span class="eyebrow">Vamos conversar</span><h1>Conheça os caminhos do Atlas.</h1><p>Preencha para preparar uma mensagem no seu aplicativo de e-mail. Os contatos são de exemplo; nada é enviado automaticamente.</p><form id="demo" class="form-grid"><label>Nome *<input name="nome" autocomplete="name" required minlength="2"/></label><label>E-mail profissional *<input name="email" type="email" autocomplete="email" required/></label><label>Organização *<input name="organizacao" autocomplete="organization" required/></label><label>Seu perfil *<select name="perfil" required><option value="">Selecione</option><option>Comprador</option><option>Setor público</option><option>Fornecedor</option></select></label><label class="full">O que você gostaria de conhecer?<textarea name="mensagem" rows="4"></textarea></label><label class="full"><span><input type="checkbox" name="consentimento" required style="width:auto"/> Li a <a href="/privacidade/">política de privacidade</a> e desejo preparar o contato. *</span></label><div class="full"><button class="button" type="submit">Preparar pedido</button></div><p id="confirmation" class="notice full" role="status" hidden>Pedido preparado. <a id="email-link">Abrir aplicativo de e-mail</a>. Destinatário ilustrativo: substitua por um contato real antes de enviar.</p></form></section></Base>
<script>document.querySelector<HTMLFormElement>('#demo')!.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const data=new FormData(form);const body=`Nome: ${data.get('nome')}\nE-mail: ${data.get('email')}\nOrganização: ${data.get('organizacao')}\nPerfil: ${data.get('perfil')}\n${data.get('mensagem')}`;document.querySelector<HTMLAnchorElement>('#email-link')!.href=`mailto:contato@atlas-goiania.example?subject=${encodeURIComponent('Demonstração Atlas')}&body=${encodeURIComponent(body)}`;document.querySelector<HTMLElement>('#confirmation')!.hidden=false;});</script>