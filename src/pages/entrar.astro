---
import Base from '../layouts/Base.astro';
---
<Base title="Entrar na plataforma">
  <meta slot="head" name="robots" content="noindex" />
  <section class="prose">
    <h1>Entrar na plataforma</h1>
    <p>Acesso restrito à equipe. Ambiente demonstrativo.</p>
    <p id="login-error" class="notice" role="alert" hidden>E-mail ou senha inválidos. Tente novamente.</p>
    <form method="post" action="/api/login" class="form-grid">
      <div class="full"><label for="login-email">E-mail</label><input id="login-email" name="email" type="email" autocomplete="username" required /></div>
      <div class="full"><label for="login-password">Senha</label><input id="login-password" name="senha" type="password" autocomplete="current-password" required /></div>
      <input id="login-next" type="hidden" name="next" value="/plataforma/" />
      <div class="full"><button type="submit">Entrar</button></div>
    </form>
  </section>
</Base>
<script>
  const params = new URLSearchParams(location.search);
  const next = document.querySelector<HTMLInputElement>('#login-next');
  if (next) next.value = params.get('next') || '/plataforma/';
  const error = document.querySelector<HTMLElement>('#login-error');
  if (error && params.get('erro') === '1') error.hidden = false;
</script>
