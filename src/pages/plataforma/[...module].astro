---
import type { HTMLAttributes } from 'astro/types';
type InputType = HTMLAttributes<'input'>['type'];
import Icon from '../../components/Icon.astro';
import ModuleContent from '../../components/ModuleContent.astro';
import Platform from '../../layouts/Platform.astro';import DataTable from '../../components/DataTable.astro';import Chart from '../../components/Chart.astro';import Marketplace from '../../components/Marketplace.astro';import modules from '../../data/modules.json';import {modulosComDadosReais} from '../../lib/dados/captacao.ts';import offers from '../../data/offers.json';
export function getStaticPaths(){return [...modulosComDadosReais(modules).map(m=>({params:{module:m.slug||undefined},props:{module:m as (typeof modules)[number],offer:null}})),...offers.map(o=>({params:{module:`oferta-${o.id}`},props:{module:modules.find(m=>m.slug==='marketplace')!,offer:o}}))];}const {module:m,offer}=Astro.props;const dashboard=m.slug==='';const account=['perfil','configuracoes'].includes(m.slug);
const intros:Record<string,string>={processos:'Acompanhe licitações por status.',cotacoes:'Compare consultas ao mercado por status da cotação.',documentos:'Prepare ETP, DFD, TR e Edital com modelos locais e revisão humana.', 'gestao-publica':'Monitore etapas, prazos e decisões da carteira municipal.',solicitacoes:'Faça a triagem dos pedidos de compra.',recursos:'Acompanhe manifestações e decisões das licitações.',diligencias:'Confira notificações e prazos de resposta.',pareceres:'Organize respostas técnicas e análises de fornecedores.',captacao:'Acompanhe as demandas em fase de captação.','captacao-oportunidades':'Programas e editais abertos compatíveis com as necessidades do município.','captacao-acompanhamento':'Convênios e repasses: pactuado, liberado e saldo a liberar.','captacao-qualidade':'Quão atuais estão os dados de cada fonte, falhas de coleta e o motivo de cada atraso.',
'captacao-alertas':'Prazos e pendências com ação recomendada e responsável. Agenda para importar no Google Agenda ou Outlook: /plataforma/agenda.ics',
'captacao-comparativo':'Compare os repasses da saúde de Goiânia com as demais capitais por habitante e veja o que outras capitais recebem e Goiânia não.','captacao-projetos':'Rascunhos, versões e aprovações de propostas.','banco-de-precos':'Pesquise itens e compare preços de contratações de exemplo.',atas:'Consulte itens homologados, saldos e vigências.','piloto-automatico':'Acompanhe regras e alertas de prazo.',marketplace:'Encontre produtos e serviços para sua cotação.','minha-cotacao':'Revise as ofertas selecionadas nesta sessão.',produtos:'Catálogo municipal de produtos e serviços.',fornecedores:'Empresas fictícias do cadastro de fornecedores.',enderecos:'Endereços das unidades municipais.','locais-de-entrega':'Pontos de recebimento da rede municipal.',relatorios:'Explore prévias de relatórios da operação.',perfil:'Dados de exemplo da equipe, apenas para leitura.',configuracoes:'Preferências demonstrativas, apenas para leitura.',pedidos:'Solicitações de propostas enviadas aos fornecedores.',negociacoes:'Conversas e pendências das negociações.',embarcacoes:'Cadastro demonstrativo de unidades de apoio.'};
const friendly:Record<string,string>={name:'Nome',phone:'Telefone',socinal_name:'Razão social',email:'E-mail',address:'Endereço',city:'Cidade',state:'UF',country:'País',zip_code:'CEP',cnpj:'CNPJ',ie:'Inscrição estadual',website:'Site',agencia:'Agência',conta:'Conta',banco:'Banco',pix:'Chave Pix',obs:'Observações',document:'Documento',key:'Chave',type:'Tipo',url:'URL',user:'Usuário',password:'Senha',title:'Título',description:'Descrição',new_password:'Nova senha',new_password_confirmation:'Confirmar nova senha'};
const fields=m.fields.map(f=>{const [key,rest='text']=f.split(':');const type=rest.split(' ')[0];const label=rest.match(/\((.*)\)/)?.[1]||friendly[key]||key.replaceAll('_',' ');return {key,type,label};});
---
<Platform title={offer?offer.title:m.title} slug={m.slug}><div class="section-head"><div><h1>{dashboard?'Olá, Prefeitura Municipal de Goiânia':offer?offer.title:m.title}</h1><p class="muted">{dashboard?'Acompanhe sua operação e encontre o próximo passo.':intros[m.slug]}{(m as any).fonte&&<><br/><small>{(m as any).fonte}</small></>}</p></div>{!dashboard&&<button class="primary" data-prototype data-doc-open={m.slug==='documentos'?'true':undefined} disabled={account}><Icon name={m.slug==='documentos'?'sparkles':'plus'} size={16}/>{m.slug==='documentos'?'Gerar rascunho':account?'Salvar alterações':'Novo registro'}</button>}{dashboard&&<div class="actions"><a class="button primary" data-astro-reload href="/plataforma/processos/"><Icon name="plus"/>Novo processo</a><a class="button secondary" data-astro-reload href="/plataforma/cotacoes/">Ver cotações</a></div>}</div>
{dashboard&&<><div class="grid">{[['34','Processos ativos'],['R$ 2,4 mi','Carteira estimada'],['92%','Dentro do SLA'],['7','Na fila do gestor']].map(([v,l],i)=><article class="card kpi"><div class="kpi-top"><span class="kpi-icon"><Icon name={['check','trend','box','users'][i]}/></span><Icon name="trend"/></div><span class="muted">{l}</span><div class="number" data-count={v}>{v}</div><small>Dados de exemplo</small><svg class="kpi-arcs" viewBox="0 0 180 180" fill="none" stroke="currentColor" stroke-width="16" aria-hidden="true"><circle cx="90" cy="90" r="75"/><circle cx="90" cy="90" r="45"/></svg></article>)}</div><div class="dashboard-charts"><Chart/><article class="card"><h2 style="font-size:1.2rem">Atividade recente</h2>{[['Finalizados',24],['Pendentes',7],['Em revisão',3]].map(([label,n])=><p>{label} · {n}<meter min="0" max="34" value={n}>{n}</meter></p>)}<h3>Saúde da carteira</h3><p>24 em dia · 7 em atenção · 3 com prazo vencido</p><p><strong>Próximas etapas</strong></p><p>Planejamento → Pesquisa → Revisão → Publicação</p><a data-astro-reload href="/plataforma/gestao-publica/">Abrir cockpit →</a></article></div><h2>{m.slug===''?'Oportunidades e processos recentes':'Fila do gestor'}</h2></>}
{offer?<article class="card"><span class="pill">{offer.type} · {offer.category} · {offer.uf}</span><h2>Informações da oferta</h2><p>Oferta fictícia para atendimento à rede municipal. Preço unitário estimado: {offer.price.toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}.</p><h3>Fornecedor</h3><p>{offer.provider}</p><form data-prototype-form class="form-grid"><label>Quantidade *<input type="number" min="1" value="1" required/></label><label>Prazo desejado *<input type="date" required/></label><label>Local de entrega / execução *<textarea required></textarea></label><label>Observações<textarea/></label><div class="actions"><button data-prototype>Solicitar proposta</button><button type="button" data-prototype>Negociar</button><button type="button" data-prototype>Emitir pedido</button><button type="button" data-prototype>Salvar fornecedor</button><button type="button" data-offer-add={offer.id} data-prototype>Adicionar à cotação</button></div></form></article>:m.slug==='marketplace'||m.slug==='minha-cotacao'?<Marketplace basket={m.slug==='minha-cotacao'}/>:<>
<ModuleContent module={m}/>
{m.slug==='piloto-automatico'&&<article class="card"><h2>Regras de acompanhamento</h2><p>Monitore prazos, novas demandas e mudanças de etapa.</p><label><span><input type="checkbox" style="width:auto"/> Notificar a equipe sobre prazos em atenção</span></label><button data-prototype>Ativar regra</button></article>}
{fields.length>0&&<details class="card" open={account}><summary>{account?'Dados e preferências':'Campos e filtros do módulo'}</summary><form data-prototype-form class="form-grid"><fieldset disabled={account} class="form-grid full">{fields.map(f=><label>{f.label}{f.type.includes('select')?<select name={f.key}><option>Selecione</option>{['Exemplo','GO','Educação','Saúde','Ativo'].map(t=><option>{t}</option>)}</select>:f.type==='textarea'?<textarea name={f.key} rows="3"/>:<input name={f.key} type={['text','email','url','password','number','date','file','color','range','checkbox'].includes(f.type)?f.type as InputType:'text'} value={account&&f.type!=='password'?'Equipe Goiânia (exemplo)':undefined} placeholder={f.type==='text'?'Dado de exemplo':undefined}/>}</label>)}</fieldset><div class="full"><button disabled={account} data-prototype>{account?'Salvar preferências':'Aplicar simulação'}</button></div></form></details>}
{!account&&m.slug!=='relatorios'&&<div id={m.slug==='gestao-publica'?'manager-queue':undefined}><DataTable slug={m.slug} columns={m.columns} rows={m.rows} title={m.title} cockpit={m.slug==='gestao-publica'} detalhes={(m as any).detalhes} real={!!(m as any).fonte}/></div>}
</>}
<dialog id="doc-dialog"><h2>Gerar rascunho demonstrativo</h2><p>Protótipo local, sem consulta a IA. Requer revisão técnica e jurídica.</p><form id="draft-form" class="form-grid"><div><label for="draft-kind">Tipo</label><select id="draft-kind" name="kind"><option>ETP</option><option>DFD</option><option>TR</option><option>Edital</option></select></div><div><label for="draft-object">Objeto</label><input id="draft-object" name="object" required/></div><div><label for="draft-department">Secretaria</label><select id="draft-department" name="department"><option>Educação</option><option>Saúde</option><option>Infraestrutura</option></select></div><div><label for="draft-reason">Justificativa</label><textarea id="draft-reason" name="reason" required></textarea></div><button class="primary"><Icon name="sparkles" size={16}/>Gerar exemplo local</button></form><p id="doc-text" role="status"></p><form method="dialog"><button><Icon name="x" size={16}/>Fechar</button></form></dialog></Platform>
<script>
document.addEventListener('astro:page-load',()=>{

document.querySelector('[data-doc-open="true"]')?.addEventListener('click',()=>document.querySelector<HTMLDialogElement>('#doc-dialog')!.showModal());
document.querySelector<HTMLFormElement>('#draft-form')?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(e.currentTarget as HTMLFormElement);document.querySelector('#doc-text')!.textContent=`${d.get('kind')} — Rascunho de exemplo. Objeto: ${d.get('object')}. Secretaria: ${d.get('department')}. Justificativa: ${d.get('reason')}. Estimativa e requisitos deverão ser definidos pela equipe técnica. Protótipo: nada é gravado.`;});
document.querySelector('[data-offer-add]')?.addEventListener('click',e=>{const id=Number((e.currentTarget as HTMLElement).dataset.offerAdd);try{const basket:number[]=JSON.parse(sessionStorage.getItem('atlas-basket')||'[]');if(!basket.includes(id))basket.push(id);sessionStorage.setItem('atlas-basket',JSON.stringify(basket))}catch{}});

});
</script>
