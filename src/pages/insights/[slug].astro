---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('insights')).map(entry=>({params:{slug:entry.id},props:{entry}}));}const {entry}=Astro.props;const {Content}=await render(entry);const related=(await getCollection('insights')).filter(e=>e.id!==entry.id&&e.data.tipo===entry.data.tipo);const minutes=Math.max(1,Math.ceil((entry.body||'').split(/\s+/).length/200));
---
<Base title={entry.data.title} description={entry.data.resumo} article><script slot="head" type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:entry.data.title,datePublished:entry.data.date.toISOString(),author:{'@type':'Organization',name:'Equipe Atlas Goiânia Conecta'},description:entry.data.resumo}).replace(/</g,'\\u003c')}/><article class="container prose"><a href={`/tipo/${entry.data.tipo}/`}>{entry.data.tipo}</a><h1>{entry.data.title}</h1><p class="muted"><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('pt-BR',{timeZone:'UTC'})}</time> · {minutes} min de leitura · Equipe Atlas</p><p class="lead">{entry.data.resumo}</p><Content/><h2>Continue a leitura</h2>{related.map(e=><p><a href={`/insights/${e.id}/`}>{e.data.title}</a></p>)}<a href="/insights/">← Voltar aos Insights</a></article></Base>